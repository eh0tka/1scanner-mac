    "Your changes will be lost if you close it without saving. The original file stays as it was." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если закрыть без сохранения, изменения будут потеряны. Исходный файл останется как был."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо закрити файл без збереження, зміни буде втрачено. Оригінальний файл залишиться без змін."
          }
        },
        "de" : {
          "stringUnit" : {
