          }
        }
      }
    },
    "1Scanner spends nothing on ads, so people telling people is how it grows. Share a link to its page; nothing is sent unless you choose where." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1Scanner не тратит деньги на рекламу, поэтому о нем узнают от других людей. Поделитесь ссылкой на его страницу: ничего не отправится, пока вы сами не выберете куда."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1Scanner нічого не витрачає на рекламу, тож росте завдяки тому, що люди розповідають про нього одне одному. Поширте посилання на сторінку програми; нічого не надсилається, доки ви самі не виберете куди."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1Scanner gibt nichts für Werbung aus – die App wächst durch Empfehlungen. Teile einen Link zu ihrer Seite; es wird nichts gesendet, solange du nicht selbst wählst, wohin."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1Scanner geeft niets uit aan advertenties, dus het groeit doordat mensen het aan elkaar vertellen. Deel een link naar de pagina; er wordt niets verstuurd tenzij je kiest waarheen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1Scanner no gasta nada en publicidad, así que crece cuando unas personas se lo recomiendan a otras. Comparte un enlace a su página; no se envía nada a menos que elijas adónde."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O 1Scanner não gasta nada com anúncios, então ele cresce com a indicação de quem usa. Compartilhe um link para a página dele; nada é enviado a menos que você escolha para onde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1Scanner ne dépense rien en publicité : il grandit grâce au bouche-à-oreille. Partagez un lien vers sa page ; rien n’est envoyé tant que vous ne choisissez pas où."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1Scanner non spende nulla in pubblicità, quindi cresce grazie al passaparola. Condividi un link alla sua pagina; non viene inviato nulla finché non scegli dove."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1Scanner nie wydaje nic na reklamy, więc rośnie dzięki poleceniom. Udostępnij link do jego strony; nic nie zostanie wysłane, dopóki nie wybierzesz, dokąd."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1Scanner reklama hiç para harcamaz; insanların birbirine anlatmasıyla büyür. Sayfasının bağlantısını paylaşın; nereye gideceğini siz seçmedikçe hiçbir şey gönderilmez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1Scannerは広告にお金をかけていないので、口コミで広がっています。ページへのリンクを共有してください。送信先を選ばない限り、何も送信されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1Scanner는 광고에 돈을 쓰지 않아서 사람들의 추천으로 성장합니다. 앱 페이지 링크를 공유하세요. 보낼 곳을 직접 선택하기 전에는 아무것도 전송되지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1Scanner 不花钱做广告，全靠口口相传。分享它的网页链接即可；除非你自己选择发送到哪里，否则不会发送任何内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1Scanner 不花錢買廣告，靠的是口耳相傳。分享它的網頁連結；除非你選擇傳送對象，否則不會傳送任何內容。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1Scanner tidak mengeluarkan biaya untuk iklan, jadi app ini tumbuh dari cerita orang ke orang. Bagikan tautan ke halamannya; tidak ada yang dikirim kecuali Anda memilih tujuannya."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1Scanner không chi tiền cho quảng cáo, nên ứng dụng phát triển nhờ mọi người giới thiệu cho nhau. Hãy chia sẻ liên kết đến trang của ứng dụng; không có gì được gửi đi trừ khi bạn chọn nơi gửi."
          }
        }
      }
    },
    "1Scanner switches to the new language after a restart." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1Scanner переключится на новый язык после перезапуска."
          }
        },
        "uk" : {
          "stringUnit" : {
