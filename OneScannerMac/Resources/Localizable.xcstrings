    "“%@” can't be opened. It may be damaged or not a PDF." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удается открыть «%@». Возможно, файл поврежден или это не PDF."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдається відкрити «%@». Можливо, файл пошкоджено або це не PDF."
