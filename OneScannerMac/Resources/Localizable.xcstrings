    "Couldn't install the update (%@). This copy is now “%@” in the same folder: rename it back to 1Scanner." : {
      "comment" : "Install and Relaunch error when the old copy couldn't get its name back. Placeholders: the system's message, the app's current file name.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Couldn't install the update (%1$@). This copy is now “%2$@” in the same folder: rename it back to 1Scanner."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось установить обновление (%@). Эта копия теперь называется «%@» в той же папке: переименуйте ее обратно в 1Scanner."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося встановити оновлення (%@). Ця копія тепер називається «%@» і лежить у тій самій папці: перейменуйте її назад на 1Scanner."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Update konnte nicht installiert werden (%@). Diese Kopie heißt jetzt „%@“ im selben Ordner: Benenne sie wieder in 1Scanner um."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan de update niet installeren (%@). Deze kopie heet nu ‘%@’ in dezelfde map: wijzig de naam terug in 1Scanner."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo instalar la actualización (%@). Esta copia ahora se llama «%@» en la misma carpeta: vuelve a llamarla 1Scanner."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível instalar a atualização (%@). Esta cópia agora se chama “%@” na mesma pasta: renomeie-a de volta para 1Scanner."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d’installer la mise à jour (%@). Cette copie s’appelle maintenant « %@ » dans le même dossier : redonnez-lui le nom 1Scanner."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile installare l'aggiornamento (%@). Ora questa copia si chiama «%@» nella stessa cartella: rinominala di nuovo in 1Scanner."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
