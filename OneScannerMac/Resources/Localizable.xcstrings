    "Original, Medium, Small, or up to the size a website or email asks for." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оригинал, средний, маленький или до размера, который требует сайт или почта."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оригінальний, середній чи малий розмір — або не більший, ніж вимагає сайт чи пошта."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
