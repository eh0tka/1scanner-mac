    "By page ranges like 1-3, 5, 8-10, every few pages or page by page." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По диапазонам страниц, например 1-3, 5, 8-10, через каждые несколько страниц или постранично."
