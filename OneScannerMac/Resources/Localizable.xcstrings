            "value" : "O copia una captura de pantalla (⌘⌃⇧4) y pégala con ⌘V."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou copie uma captura de tela (⌘⌃⇧4) e cole com ⌘V."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou copiez une capture d’écran (⌘⌃⇧4) et collez-la avec ⌘V."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oppure copia uno screenshot (⌘⌃⇧4) e incollalo con ⌘V."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Możesz też skopiować zrzut ekranu (⌘⌃⇧4) i wkleić go za pomocą ⌘V."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya da bir ekran görüntüsünü kopyalayın (⌘⌃⇧4) ve ⌘V ile yapıştırın."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "または、スクリーンショットをコピー（⌘⌃⇧4）して⌘Vでペーストします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "또는 스크린샷을 복사(⌘⌃⇧4)한 다음 ⌘V로 붙여넣으세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "或者拷贝一张截屏（⌘⌃⇧4），然后按 ⌘V 粘贴。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "或將截圖拷貝到剪貼板（⌘⌃⇧4），再用 ⌘V 貼上。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atau salin jepretan layar (⌘⌃⇧4) dan tempelkan dengan ⌘V."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoặc sao chép ảnh chụp màn hình (⌘⌃⇧4) rồi dán bằng ⌘V."
          }
        }
      }
    },
    "Or take a photo with your iPhone: File › Import from iPhone or iPad." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Или сделайте фото на iPhone: «Файл › Импортировать с iPhone или iPad»."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Або сфотографуйте на iPhone: «Файл › Імпортувати з iPhone або iPad»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oder fotografiere mit deinem iPhone: Ablage › Von iPhone oder iPad importieren."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Of maak een foto met je iPhone: Archief › Importeer van iPhone of iPad."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O haz una foto con tu iPhone: Archivo › Importar desde iPhone o iPad."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou tire uma foto com o iPhone: Arquivo › Importar do iPhone ou iPad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou prenez une photo avec votre iPhone : Fichier › Importer depuis l’iPhone ou l’iPad."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oppure scatta una foto con il tuo iPhone: File › Importa da iPhone o iPad."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Możesz też zrobić zdjęcie iPhone’em: Plik › Importuj z iPhone’a lub iPada."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya da iPhone’unuzla fotoğraf çekin: Dosya › iPhone’dan veya iPad’den içe aktar."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "または、iPhoneで写真を撮ります：ファイル › iPhoneまたはiPadから読み込む。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "또는 iPhone으로 사진을 찍으세요: 파일 › iPhone 또는 iPad에서 가져오기."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "或者用你的 iPhone 拍照：“文件 › 从 iPhone 或 iPad 导入”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "或用 iPhone 拍照：「檔案」›「從 iPhone 或 iPad 輸入」。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atau ambil foto dengan iPhone Anda: File › Impor dari iPhone atau iPad."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoặc chụp ảnh bằng iPhone: Tệp › Nhập từ iPhone hoặc iPad."
          }
        }
      }
    },
