    "A file needs at least one page. To get rid of it, close the file." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В файле должна остаться хотя бы одна страница. Чтобы убрать файл, закройте его."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У файлі має бути хоча б одна сторінка. Щоб позбутися його, закрийте файл."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Datei braucht mindestens eine Seite. Um sie zu entfernen, schließe die Datei."
          }
        },
        "nl" : {
          "stringUnit" : {
