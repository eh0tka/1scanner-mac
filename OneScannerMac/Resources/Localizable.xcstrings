    "Sizes are measured on this Mac: the file you save is exactly this size." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Размеры измерены на этом Mac: сохраненный файл будет именно такого размера."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Розміри виміряно на цьому Mac: збережений файл матиме саме такий розмір."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Größen werden auf diesem Mac gemessen: Die gesicherte Datei hat genau diese Größe."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Groottes worden op deze Mac gemeten: het bestand dat je bewaart, heeft precies deze grootte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los tamaños se miden en este Mac: el archivo que guardes tendrá exactamente este tamaño."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os tamanhos são medidos neste Mac: o arquivo que você salvar terá exatamente este tamanho."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les tailles sont mesurées sur ce Mac : le fichier enregistré fait exactement cette taille."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le dimensioni sono misurate su questo Mac: il file che salvi ha esattamente questa dimensione."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozmiary są mierzone na tym Macu: zachowany plik ma dokładnie taki rozmiar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boyutlar bu Mac'te ölçülür: kaydettiğiniz dosya tam olarak bu boyutta olur."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サイズはこのMac上で測定しています。保存されるファイルはちょうどこのサイズです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "크기는 이 Mac에서 측정합니다. 저장하는 파일은 정확히 이 크기입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大小在这台 Mac 上实测得出：你存储的文件就是这个大小。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大小是在這台 Mac 上實際測量的：你儲存的檔案就是這個大小。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukuran dihitung di Mac ini: file yang Anda simpan berukuran persis seperti ini."
          }
        },
        "vi" : {
