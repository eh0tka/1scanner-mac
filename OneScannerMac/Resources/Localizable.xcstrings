    "“%@” is open in 1Scanner, so it can't be replaced. Save under another name." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» открыт в 1Scanner, поэтому его нельзя заменить. Сохраните под другим именем."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» відкрито в 1Scanner, тому його не можна замінити. Збережіть під іншою назвою."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ ist in 1Scanner geöffnet und kann daher nicht ersetzt werden. Sichere unter einem anderen Namen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’ is open in 1Scanner en kan dus niet worden vervangen. Bewaar onder een andere naam."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» está abierto en 1Scanner, así que no se puede reemplazar. Guárdalo con otro nombre."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” está aberto no 1Scanner e não pode ser substituído. Salve com outro nome."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » est ouvert dans 1Scanner et ne peut donc pas être remplacé. Enregistrez sous un autre nom."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» è aperto in 1Scanner, quindi non può essere sostituito. Salva con un altro nome."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plik „%@” jest otwarty w aplikacji 1Scanner, więc nie można go zastąpić. Zachowaj pod inną nazwą."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” 1Scanner'da açık olduğu için üzerine yazılamaz. Başka bir adla kaydedin."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」は1Scannerで開いているため、置き換えられません。別の名前で保存してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’은(는) 1Scanner에서 열려 있으므로 대치할 수 없습니다. 다른 이름으로 저장하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”已在 1Scanner 中打开，因此无法替换。请用其他名称存储。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」正在 1Scanner 中打開，因此無法取代。請以其他名稱儲存。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” sedang terbuka di 1Scanner, jadi tidak dapat diganti. Simpan dengan nama lain."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” đang mở trong 1Scanner nên không thể thay thế. Hãy lưu với tên khác."
          }
        }
      }
    },
    "“%@” is protected with a password. Save a copy that opens without it, or a copy with a new one." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» защищен паролем. Сохраните копию, которая открывается без пароля, или копию с новым паролем."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» захищено паролем. Збережіть копію, яка відкривається без пароля, або копію з новим паролем."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ ist mit einem Passwort geschützt. Sichere eine Kopie, die sich ohne Passwort öffnet, oder eine Kopie mit neuem Passwort."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’ is beveiligd met een wachtwoord. Bewaar een kopie die zonder wachtwoord opent, of een kopie met een nieuw wachtwoord."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» está protegido con contraseña. Guarda una copia que se abra sin ella o una copia con una nueva."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” está protegido por senha. Salve uma cópia que abra sem senha ou uma cópia com uma senha nova."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » est protégé par un mot de passe. Enregistrez une copie qui s’ouvre sans mot de passe, ou une copie avec un nouveau mot de passe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» è protetto da password. Salva una copia che si apre senza password o una copia con una nuova password."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plik „%@” jest chroniony hasłem. Zachowaj kopię, która otwiera się bez niego, albo kopię z nowym hasłem."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” parolayla korunuyor. Parolasız açılan bir kopya ya da yeni parolalı bir kopya kaydedin."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」はパスワードで保護されています。パスワードなしで開けるコピーか、新しいパスワードを設定したコピーを保存してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’은(는) 비밀번호로 보호되어 있습니다. 비밀번호 없이 열리는 사본이나 새 비밀번호가 있는 사본을 저장하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”受密码保护。你可以存储一个无需密码即可打开的副本，或一个使用新密码的副本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」受密碼保護。你可以儲存一份不需密碼即可打開的副本，或一份使用新密碼的副本。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” dilindungi kata sandi. Simpan salinan yang terbuka tanpa kata sandi, atau salinan dengan kata sandi baru."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” được bảo vệ bằng mật khẩu. Hãy lưu một bản sao mở được mà không cần mật khẩu, hoặc một bản sao có mật khẩu mới."
          }
        }
      }
    },
