          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prima salva o chiudi i file con modifiche: 1Scanner si riavvia per completare l'aggiornamento."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najpierw zachowaj lub zamknij pliki ze zmianami: 1Scanner uruchomi się ponownie, aby dokończyć uaktualnienie."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
