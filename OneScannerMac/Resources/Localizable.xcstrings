          }
        }
      }
    },
    "Or copy a screenshot (⌘⌃⇧4) and paste it with ⌘V." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Или скопируйте снимок экрана (⌘⌃⇧4) и вставьте его с помощью ⌘V."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Або скопіюйте знімок екрана (⌘⌃⇧4) і вставте його за допомогою ⌘V."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oder kopiere ein Bildschirmfoto (⌘⌃⇧4) und setze es mit ⌘V ein."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Of kopieer een schermafbeelding (⌘⌃⇧4) en plak die met ⌘V."
