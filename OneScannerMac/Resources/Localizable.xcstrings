    "“%@” is not the site. The real site is %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "“%1$@” is not the site. The real site is %2$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» — это не сайт. Настоящий сайт — %@."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Посилання веде не на «%1$@». Справжній сайт — %2$@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ ist nicht die Website. Die echte Website ist %@."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%1$@’ is niet de site. De echte site is %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El enlace no lleva a «%@». El sitio real es %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O link não leva a “%@”. O site real é %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le lien ne mène pas à « %@ ». Le vrai site est %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il link non porta a «%1$@». Il sito reale è %2$@."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@” to nie jest właściwa witryna. Prawdziwa witryna to %2$@."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” gerçek site değil. Gerçek site: %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このリンクは「%1$@」のサイトではありません。実際のサイトは%2$@です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%1$@’ 사이트가 아닙니다. 실제 사이트는 %2$@입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@”并不是链接真正指向的网站。真实网站是 %2$@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%1$@」並不是連結實際前往的網站。真正的網站是 %2$@。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” bukan situs yang akan dibuka. Situs sebenarnya adalah %@."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” không phải là trang web sẽ mở. Trang web thật là %@."
