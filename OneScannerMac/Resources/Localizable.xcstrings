    "Put your signature, initials or a company seal on any page, or on all of them." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ставьте свою подпись, инициалы или печать компании на любую страницу или сразу на все."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ставте свій підпис, ініціали або печатку компанії на будь-яку сторінку чи на всі одразу."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setze deine Unterschrift, Initialen oder einen Firmenstempel auf eine beliebige Seite oder auf alle."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet je handtekening, initialen of bedrijfsstempel op elke gewenste pagina, of op allemaal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pon tu firma, tus iniciales o el sello de tu empresa en cualquier página o en todas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloque sua assinatura, rubrica ou o carimbo da empresa em qualquer página ou em todas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Placez votre signature, vos initiales ou le cachet de votre entreprise sur n’importe quelle page, ou sur toutes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applica la tua firma, le iniziali o un timbro aziendale su qualsiasi pagina o su tutte."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umieść swój podpis, parafę lub pieczątkę firmową na dowolnej stronie albo na wszystkich."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İmzanızı, parafınızı veya şirket kaşenizi istediğiniz sayfaya ya da tüm sayfalara yerleştirin."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "署名、イニシャル、社印を、任意のページまたはすべてのページに配置できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서명, 이니셜 또는 회사 도장을 원하는 페이지나 모든 페이지에 넣으세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将你的签名、姓名缩写或公司印章放到任意一页或所有页面上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
