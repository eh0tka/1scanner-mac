    "Changes in %@ aren't saved. Use Save As… to keep them." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изменения в %@ не сохранены. Чтобы не потерять их, выберите «Сохранить как…»."
