    "Add your signature or a company seal once; it stays in 1Scanner on this Mac for every document." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте свою подпись или печать компании один раз — она останется в 1Scanner на этом Mac для всех документов."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додайте свій підпис або печатку компанії один раз — вони зберігатимуться в 1Scanner на цьому Mac для всіх документів."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge deine Unterschrift oder einen Firmenstempel einmal hinzu – sie bleiben in 1Scanner auf diesem Mac für jedes Dokument bereit."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg je handtekening of bedrijfsstempel één keer toe; hij blijft in 1Scanner op deze Mac voor elk document."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade tu firma o el sello de tu empresa una vez; se queda en 1Scanner en este Mac para todos tus documentos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione sua assinatura ou o carimbo da empresa uma vez; tudo fica guardado no 1Scanner neste Mac, pronto para qualquer documento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez une seule fois votre signature ou le cachet de votre entreprise ; il reste dans 1Scanner sur ce Mac pour tous vos documents."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi una volta la tua firma o un timbro aziendale: resta in 1Scanner su questo Mac per ogni documento."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj raz swój podpis lub pieczątkę firmową; zostanie w aplikacji 1Scanner na tym Macu, do użycia w każdym dokumencie."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İmzanızı veya şirket kaşenizi bir kez ekleyin; tüm belgeler için bu Mac'teki 1Scanner'da kalır."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "署名や社印を一度追加すれば、このMacの1Scannerに保存され、どの書類にも使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서명이나 회사 도장을 한 번만 추가하면 이 Mac의 1Scanner에 보관되어 모든 문서에 사용할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只需添加一次你的签名或公司印章；它会保存在这台 Mac 上的 1Scanner 中，可用于每份文档。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "簽名或公司印章只要新增一次，就會保留在這台 Mac 的 1Scanner 中，可用於每份文件。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambahkan tanda tangan atau stempel perusahaan Anda sekali; hasilnya tersimpan di 1Scanner di Mac ini untuk semua dokumen."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thêm chữ ký hoặc con dấu công ty một lần; nó được giữ trong 1Scanner trên máy Mac này để dùng cho mọi tài liệu."
          }
        }
      }
    },
