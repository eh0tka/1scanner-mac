    "Save or close the files with changes first: 1Scanner restarts to finish the update." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сначала сохраните или закройте измененные файлы: чтобы завершить обновление, 1Scanner перезапустится."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спершу збережіть або закрийте файли зі змінами: 1Scanner перезапуститься, щоб завершити оновлення."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sichere oder schließe zuerst die Dateien mit Änderungen: 1Scanner startet neu, um das Update abzuschließen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewaar of sluit eerst de bestanden met wijzigingen: 1Scanner start opnieuw om de update te voltooien."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes, guarda o cierra los archivos con cambios: 1Scanner se reinicia para terminar la actualización."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes, salve ou feche os arquivos com alterações: o 1Scanner reinicia para concluir a atualização."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
