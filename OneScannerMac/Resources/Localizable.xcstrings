    "Send only on the networks listed above. Coins sent on another network can't be recovered." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отправляйте только в сетях, указанных выше. Монеты, отправленные в другой сети, вернуть нельзя."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надсилайте лише в мережах, указаних вище. Монети, надіслані в іншій мережі, повернути неможливо."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sende nur über die oben aufgeführten Netzwerke. Über ein anderes Netzwerk gesendete Coins können nicht wiederhergestellt werden."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuur alleen via de netwerken hierboven. Munten die via een ander netwerk zijn gestuurd, kunnen niet worden teruggehaald."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía solo por las redes indicadas arriba. Las monedas enviadas por otra red no se pueden recuperar."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envie somente pelas redes listadas acima. Moedas enviadas por outra rede não podem ser recuperadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyez uniquement sur les réseaux indiqués ci-dessus. Les cryptomonnaies envoyées sur un autre réseau ne peuvent pas être récupérées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invia solo sulle reti elencate sopra. Le monete inviate su un'altra rete non si possono recuperare."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wysyłaj tylko w sieciach wymienionych powyżej. Środków wysłanych w innej sieci nie da się odzyskać."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca yukarıda listelenen ağlar üzerinden gönderin. Başka bir ağ üzerinden gönderilen kripto paralar geri alınamaz."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上記のネットワークでのみ送金してください。別のネットワークで送ったコインは復元できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위에 표시된 네트워크로만 보내세요. 다른 네트워크로 보낸 코인은 복구할 수 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请仅通过上面列出的网络发送。通过其他网络发送的币将无法找回。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只能透過上方列出的網路傳送。透過其他網路傳送的幣將無法找回。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirim hanya melalui jaringan yang tercantum di atas. Koin yang dikirim melalui jaringan lain tidak dapat dipulihkan."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ gửi qua các mạng được liệt kê ở trên. Tiền mã hóa gửi qua mạng khác sẽ không thể khôi phục."
          }
        }
      }
    },
