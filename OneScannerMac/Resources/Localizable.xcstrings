    "or click to open. Images become pages of a new PDF." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "или нажмите, чтобы открыть. Изображения станут страницами нового PDF."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "або клацніть, щоб відкрити. Зображення стануть сторінками нового PDF."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "oder klicke zum Öffnen. Bilder werden zu Seiten eines neuen PDFs."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "of klik om te openen. Afbeeldingen worden pagina's van een nieuwe PDF."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "o haz clic para abrir. Las imágenes se convierten en páginas de un PDF nuevo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ou clique para abrir. As imagens viram páginas de um novo PDF."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ou cliquez pour ouvrir. Les images deviennent les pages d’un nouveau PDF."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "o fai clic per aprire. Le immagini diventano pagine di un nuovo PDF."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "lub kliknij, aby otworzyć. Obrazy staną się stronami nowego pliku PDF."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ya da açmak için tıklayın. Görüntüler yeni bir PDF'nin sayfaları olur."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "またはクリックして開きます。画像は新しいPDFのページになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "또는 클릭하여 여세요. 이미지는 새 PDF의 페이지가 됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "或点按以打开。图像会成为新 PDF 的页面。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
