    "Drag to reorder" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетащите, чтобы изменить порядок"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетягніть, щоб змінити порядок"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Neuordnen ziehen"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep om de volgorde te wijzigen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra para reordenar"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste para reordenar"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser pour réorganiser"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina per riordinare"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przeciągnij, aby zmienić kolejność"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeniden sıralamak için sürükleyin"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドラッグして並べ替え"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "드래그하여 순서 변경"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖移以重新排序"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖移以重新排序"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seret untuk mengubah urutan"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kéo để sắp xếp lại"
          }
        }
      }
    },
    "Drag to reorder. Drop PDFs or images to add pages. Save As… makes a new file; the original stays as it is." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетаскивайте, чтобы изменить порядок. Перетащите сюда PDF или изображения, чтобы добавить страницы. «Сохранить как…» создает новый файл, а оригинал остается как есть."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетягніть, щоб змінити порядок. Перетягніть сюди PDF або зображення, щоб додати сторінки. «Зберегти як…» створює новий файл; оригінал залишається як є."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Neuordnen ziehen. Lege PDFs oder Bilder hier ab, um Seiten hinzuzufügen. „Sichern unter …“ erstellt eine neue Datei; das Original bleibt unverändert."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep om de volgorde te wijzigen. Zet PDF's of afbeeldingen neer om pagina's toe te voegen. ‘Bewaar als…’ maakt een nieuw bestand; het origineel blijft zoals het is."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra para reordenar. Suelta PDF o imágenes para añadir páginas. Guardar como… crea un archivo nuevo; el original se queda como está."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste para reordenar. Solte PDFs ou imagens para adicionar páginas. Salvar Como… cria um novo arquivo; o original fica como está."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser pour réorganiser. Déposez des PDF ou des images pour ajouter des pages. Enregistrer sous… crée un nouveau fichier ; l’original reste tel quel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina per riordinare. Rilascia PDF o immagini per aggiungere pagine. Salva con nome… crea un nuovo file; l'originale resta com'è."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przeciągnij, aby zmienić kolejność. Upuść pliki PDF lub obrazy, aby dodać strony. Zachowaj jako… tworzy nowy plik; oryginał pozostaje bez zmian."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeniden sıralamak için sürükleyin. Sayfa eklemek için PDF veya görüntü bırakın. Farklı Kaydet… yeni bir dosya oluşturur; orijinal olduğu gibi kalır."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドラッグして並べ替えます。PDFや画像をドロップするとページを追加できます。「別名で保存…」で新しいファイルが作成され、元のファイルはそのまま残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "드래그하여 순서를 바꾸세요. PDF나 이미지를 놓으면 페이지가 추가됩니다. ‘다른 이름으로 저장…’은 새 파일을 만들며, 원본은 그대로 유지됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖移可重新排序。拖入 PDF 或图像可添加页面。“存储为…”会创建新文件，原件保持不变。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖移以重新排序。拖放 PDF 或影像即可加入頁面。「儲存為…」會建立新檔案；原始檔案會維持原樣。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seret untuk mengubah urutan. Letakkan PDF atau gambar untuk menambah halaman. Simpan Sebagai… membuat file baru; file asli tetap seperti semula."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kéo để sắp xếp lại. Thả PDF hoặc hình ảnh vào để thêm trang. Lưu thành… tạo một tệp mới; bản gốc vẫn giữ nguyên."
          }
        }
      }
    },
