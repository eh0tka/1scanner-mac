            "state" : "translated",
            "value" : "1Scanner chuyển sang ngôn ngữ mới sau khi khởi động lại."
          }
        }
      }
    },
    "1Scanner switches to the new language after a restart. Save or close the files with changes first." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1Scanner переключится на новый язык после перезапуска. Сначала сохраните или закройте измененные файлы."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1Scanner перейде на нову мову після перезапуску. Спершу збережіть або закрийте файли зі змінами."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
