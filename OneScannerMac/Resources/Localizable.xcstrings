    "PDF tools, signatures and stamps, QR codes. Private by design · 100% on-device." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Инструменты для PDF, подписи и печати, QR-коды. Конфиденциально · 100% на устройстве."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Інструменти для PDF, підписи й печатки, QR-коди. Створено для приватності · 100% на пристрої."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PDF-Werkzeuge, Unterschriften und Stempel, QR-Codes. Privat von Grund auf · 100 % auf dem Gerät."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PDF-tools, handtekeningen en stempels, QR-codes. Ontworpen voor privacy · 100% op je apparaat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herramientas PDF, firmas y sellos, códigos QR. Privado por diseño · 100 % en el dispositivo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ferramentas de PDF, assinaturas e carimbos, QR codes. Privado por natureza · 100% no dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outils PDF, signatures et tampons, codes QR. Confidentialité dès la conception · 100 % sur l’appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strumenti PDF, firme e timbri, codici QR. Pensato per la privacy · 100% sul dispositivo."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Narzędzia PDF, podpisy i pieczątki, kody QR. Prywatność z założenia · 100% na urządzeniu."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PDF araçları, imzalar ve kaşeler, QR kodları. Gizlilik odaklı tasarım · Tamamen cihazda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PDFツール、署名とスタンプ、QRコード。プライバシー重視の設計 · 100%デバイス上で処理。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PDF 도구, 서명과 도장, QR 코드. 프라이버시 중심 설계 · 100% 기기 내 처리."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PDF 工具、签名与印章、二维码。注重隐私 · 100% 在设备上处理。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PDF 工具、簽名與印章、行動條碼。隱私優先 · 100% 在裝置上處理。"
