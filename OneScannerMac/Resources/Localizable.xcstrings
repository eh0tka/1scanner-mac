        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1Scanner gebruikt de nieuwe taal na een herstart. Bewaar of sluit eerst de bestanden met wijzigingen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
